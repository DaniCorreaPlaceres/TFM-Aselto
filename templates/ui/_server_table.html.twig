<div class="table-card" data-controller="server-table" data-server-table-url-value="{{ path('record_table', {kind: kind, section: section|default('')}|merge(context|default({}))) }}" data-server-table-export-value="{{ path('record_table_export', {kind: kind, section: section|default('')}|merge(context|default({}))) }}" data-server-table-filters-value="{{ filters|default([])|json_encode|e('html_attr') }}">
    <p role="status" data-server-table-target="status"></p>
    <table class="table"><caption>{{ caption }}</caption><thead><tr>{% for label in headers %}<th>{{ label }}</th>{% endfor %}{% if kind in ['clients', 'invitations', 'movements'] %}<th class="no-export">{{ kind == 'movements' ? 'Registro' : 'Acciones' }}</th>{% endif %}</tr></thead><tbody>{% for row in cells %}<tr>{% for cell in row %}<td>{{ cell|raw }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
    <noscript><p>Activa JavaScript para buscar y recorrer este listado paginado.</p></noscript>
</div>
