{% set route = app.request.attributes.get('_route') %}
{% if is_granted('ROLE_CLIENT') %}
    {% set links = [['client_home', 'Inicio', 'home'], ['client_movements', 'Ingresos y gastos', 'chart'], ['client_documents', 'Documentos', 'document'], ['messages', 'Mensajes', 'message'], ['client_firm', 'Mi asesoría', 'people'], ['client_profile', 'Datos fiscales', 'person'], ['client_help', 'Ayuda', 'help']] %}
{% elseif is_granted('ROLE_SUPERADMIN') %}
    {% set links = [['account', 'Inicio', 'home'], ['firms', 'Asesorías', 'people'], ['clients', 'Clientes sin asesoría', 'people']] %}
{% else %}
    {% set links = [['account', 'Inicio', 'home'], ['firm_inbox', 'Documentos', 'document'], ['clients', 'Clientes', 'people'], ['messages', 'Mensajes', 'message']] %}
    {% if is_granted('ROLE_FIRM_ADMIN') %}{% set links = links|merge([['team', 'Equipo', 'people'], ['firm_profile', 'Datos fiscales', 'person']]) %}{% endif %}
{% endif %}
{% for link in links %}
    {% set active = route == link[0] or (link[0] == 'client_documents' and route starts with 'client_document') or (link[0] == 'firm_inbox' and route == 'firm_document') or (link[0] == 'messages' and route starts with 'message_') or (link[0] == 'clients' and route in ['client_fiscal', 'firm_client_quarter']) %}
    <a href="{{ path(link[0]) }}" {% if active %}aria-current="page"{% endif %}>{{ include('ui/_icon.html.twig', {icon: link[2]}) }}<span>{{ link[1] }}</span></a>
{% endfor %}
