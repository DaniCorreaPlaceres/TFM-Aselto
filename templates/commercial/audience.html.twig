{% extends 'base.html.twig' %}
{% block title %}Aselto para {{ audience|lower }}{% endblock %}
{% block body %}
<header class="home-bar"><div class="home-bar-inner"><a class="home-brand" href="{{ path('commercial_home') }}" aria-label="Aselto, inicio"><img class="home-logo" src="{{ asset('aselto-logo-eslogan-v2.png') }}" alt="Aselto. Tus finanzas bajo control" width="320" height="120"></a><nav class="home-navigation" aria-label="Nuestros espacios"><a href="{{ path('commercial_self_employed') }}">Autónomos</a><a href="{{ path('commercial_company') }}">Empresas</a><a href="{{ path('commercial_advisory') }}">Asesorías</a></nav><a class="action" href="{{ path(app.user ? 'account' : 'login') }}">{{ app.user ? 'Tu cuenta' : 'Entrar' }}</a></div></header>
<main class="audience-page home" id="main-content" tabindex="-1">
    <section class="audience-hero"><p class="home-kicker">Aselto para {{ audience|lower }}</p><h1>{{ title }}</h1><p class="audience-intro">{{ intro }}</p><div class="hero-actions"><a class="action" href="#beneficios">Descubre cómo te ayuda <span aria-hidden="true">→</span></a>{% if kind and not app.user %}<a class="action action-secondary" href="{{ path('client_register', {kind:kind}) }}">Crear mi cuenta</a>{% endif %}</div></section>
    <section id="beneficios" aria-labelledby="benefits-title"><h2 id="benefits-title">Un espacio para trabajar con más claridad</h2><div class="audience-benefits">{% for heading, description in benefits %}<article><span class="home-audience-icon">{{ include('ui/_icon.html.twig', {icon: loop.first ? 'document' : (loop.last ? 'people' : 'chart')}) }}</span><h3>{{ heading }}</h3><p>{{ description }}</p></article>{% endfor %}</div></section>
    <section class="audience-example" aria-labelledby="example-title"><p class="home-kicker">Un caso de uso ilustrativo</p><h2 id="example-title">{{ exampleTitle }}</h2><p>{{ example }}</p><p class="muted">Ejemplo ficticio. La revisión y confirmación siempre las realiza una persona.</p></section>
    {% include 'commercial/_ai.html.twig' ignore missing %}
    <section class="audience-start"><h2>{{ kind ? 'Empieza a poner tus documentos en orden' : 'Trabaja con Aselto desde tu asesoría' }}</h2>{% if not kind %}<p>El alta de asesorías se realiza por invitación de Aselto. Abre el enlace de tu correo para completar el registro. Si ya tienes cuenta, entra a tu espacio.</p>{% else %}<p>Elige autónomo o sociedad en el registro, completa tus datos y confirma tu correo para crear la contraseña.</p>{% endif %}<div class="hero-actions">{% if app.user %}<a class="action" href="{{ path('account') }}">Tu cuenta</a>{% elseif kind %}<a class="action action-secondary" href="{{ path('client_register', {kind:kind}) }}">Crear cuenta</a><a class="quiet-link" href="{{ path('login') }}">Ya tengo cuenta</a>{% else %}<a class="action" href="{{ path('login') }}">Entrar</a>{% endif %}<a class="quiet-link" href="{{ path('commercial_home') }}">Volver a la home</a></div></section>
</main>
{% endblock %}
