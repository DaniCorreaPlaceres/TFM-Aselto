<footer class="public-footer" aria-label="Información de Aselto">
    <div class="public-footer-inner">
        <div class="public-footer-brand"><a href="{{ path('commercial_home') }}" aria-label="Aselto, inicio"><img src="{{ asset('aselto-logo-eslogan-v2.png') }}" alt="Aselto. Tus finanzas bajo control" width="220" height="110"></a><p>Documentos, personas y cifras.<br>Un lugar para trabajar con más claridad.</p></div>
        <nav aria-label="Aselto para ti"><h2>Tu espacio</h2>{% for route, label in {'commercial_self_employed':'Soy autónomo','commercial_company':'Soy empresa','commercial_advisory':'Soy asesoría','commercial_pricing':'Precios'} %}{% set target = public_page(route) %}{% if target %}<a href="{{ target }}">{{ label }}</a>{% endif %}{% endfor %}</nav>
        <nav aria-label="Conoce Aselto"><h2>Conoce Aselto</h2>{% set about = public_page('commercial_about') %}{% if about %}<a href="{{ about }}">Quiénes somos</a>{% endif %}<a href="{{ path(app.user ? 'account' : 'login') }}">{{ app.user ? 'Tu cuenta' : 'Entrar' }}</a><a href="{{ path('client_register') }}">Crear cuenta</a></nav>
        <nav aria-label="Información legal"><h2>Información</h2>{% for route, label in {'commercial_privacy':'Política de privacidad','commercial_cookies':'Política de cookies'} %}{% set target = public_page(route) %}{% if target %}<a href="{{ target }}">{{ label }}</a>{% endif %}{% endfor %}</nav>
    </div>
    <div class="public-footer-bottom">© {{ 'now'|date('Y', 'Atlantic/Canary') }} Daniel Correa Placeres<span>Aselto · Tus finanzas bajo control</span></div>
</footer>
