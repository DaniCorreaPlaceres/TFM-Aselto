{% extends 'base.html.twig' %}
{% block title %}{{ title }} · Aselto{% endblock %}
{% block body %}
<header class="home-bar"><div class="home-bar-inner"><a href="{{ path('commercial_home') }}" aria-label="Aselto, inicio"><img class="home-logo" src="{{ asset('aselto-logo-eslogan-v2.png') }}" alt="Aselto. Tus finanzas bajo control" width="320" height="120"></a><nav class="home-navigation" aria-label="Información pública"><a href="{{ path('commercial_about') }}">Quiénes somos</a><a href="{{ path('commercial_privacy') }}">Privacidad</a><a href="{{ path('commercial_cookies') }}">Cookies</a></nav><a class="action" href="{{ path(app.user ? 'account' : 'login') }}">{{ app.user ? 'Tu cuenta' : 'Entrar' }}</a></div></header>
<main class="panel wide" id="main-content" tabindex="-1"><p class="home-kicker">Información de Aselto</p><h1>{{ title }}</h1>{% if draft %}<p class="warning" role="note"><strong>Borrador del TFM.</strong> Faltan datos del titular y revisión jurídica antes de su publicación como política definitiva. No constituye una validación legal.</p>{% endif %}{% for heading, content in sections %}<section><h2>{{ heading }}</h2><p>{{ content }}</p></section>{% endfor %}{% if draft %}<p>Referencias: <a href="https://www.aepd.es/derechos-y-deberes/conoce-tus-derechos/derecho-de-informacion" rel="noreferrer">Derecho de información de la AEPD</a> y <a href="https://www.aepd.es/guias/guia-cookies.pdf" rel="noreferrer">Guía de cookies de la AEPD</a>.</p>{% endif %}<a class="quiet-link" href="{{ path('commercial_home') }}">Volver a la home</a></main>
{% endblock %}
