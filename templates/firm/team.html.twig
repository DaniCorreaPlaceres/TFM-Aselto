{% extends 'base.html.twig' %}

{% block title %}Equipo{% endblock %}

{% block body %}
    <main class="panel wide">
        <h1>Equipo</h1>

        {% for message in app.flashes('success') %}
            <p class="success">{{ message }}</p>
        {% endfor %}

        {% if team is empty %}
            <p>Todavía no hay gestores.</p>
        {% else %}
            <div class="table-card" data-controller="table" data-table-filter-column-value="1"><table class="table"><caption>Personas del equipo</caption><thead><tr><th>Correo</th><th>Papel</th></tr></thead><tbody>
                {% for member in team %}
                    <tr><td>
                        <strong>{{ member.email }}</strong>
                        </td><td>{{ member.role }}
                    </td></tr>
                {% endfor %}
            </tbody></table></div>
        {% endif %}

        <h2>Invitar a un gestor</h2>
        <p>Le enviaremos un correo para confirmar su dirección y crear su contraseña.</p>

        {% if error %}
            <p class="error" role="alert">{{ error }}</p>
        {% endif %}

        <form method="post">
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" autocomplete="off" value="{{ email }}" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('invite_advisor') }}">
            <button type="submit">Invitar a un gestor</button>
        </form>
    </main>
{% endblock %}
