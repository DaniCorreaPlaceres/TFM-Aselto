{% extends 'base.html.twig' %}

{% block title %}Datos fiscales{% endblock %}

{% block body %}
    <main class="panel">
        <h1>Datos fiscales</h1>
        <p>{{ name }}</p>

        {% for message in app.flashes('success') %}
            <p class="success">{{ message }}</p>
        {% endfor %}

        {% if error %}
            <p class="error" role="alert">{{ error }}</p>
        {% endif %}

        <form method="post">
            {{ include('_fiscal_contact.html.twig') }}
            <input type="hidden" name="version" value="{{ version }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('save_firm_profile') }}">
            <button type="submit">Guardar</button>
        </form>

        <p><a class="quiet-link" href="{{ path('account') }}">Volver a tu acceso</a></p>
    </main>
{% endblock %}
