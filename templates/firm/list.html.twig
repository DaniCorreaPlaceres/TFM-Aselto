{% extends 'base.html.twig' %}

{% block title %}Asesorías{% endblock %}

{% block body %}
    <main class="panel wide">
        <h1>Asesorías</h1>

        {% for message in app.flashes('success') %}
            <p class="success">{{ message }}</p>
        {% endfor %}

        {% if firms is empty %}
            <p>Todavía no hay asesorías.</p>
        {% else %}
            <div class="table-card" data-controller="table"><table class="table"><caption>Asesorías de la plataforma</caption><thead><tr><th>Asesoría</th><th>Correo del admin</th></tr></thead><tbody>
                {% for firm in firms %}
                    <tr><td>
                        <strong>{{ firm.name }}</strong>
                        </td><td>{{ firm.adminEmail }}
                    </td></tr>
                {% endfor %}
            </tbody></table></div>
        {% endif %}

        <a class="action" href="{{ path('platform_invitation_new', {target: 'advisory'}) }}">Invitar a una asesoría</a>
        <a class="quiet-link" href="{{ path('firm_new') }}">Dar de alta con todos sus datos</a>
    </main>
{% endblock %}
