{% extends 'firm/_review_layout.html.twig' %}

{% block title %}Bandeja de la asesoría{% endblock %}

{% block review_body %}
    <h1>Bandeja de la asesoría</h1>
    <p>Revisa los registros enviados por tus clientes.</p>
    <nav class="review-nav" aria-label="Estado de los registros">
        {% for status, label in {submitted: 'Pendientes', rejected: 'Rechazados', validated: 'Validados', personal: 'Histórico personal'} %}
            <a href="{{ path('firm_inbox', {status: status}) }}" {% if filter == status %}aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
    {{ include('ui/_server_table.html.twig', {kind: 'inbox', tableSection: filter, caption: 'Registros de esta vista', headers: ['Cliente y documento', 'Estado', 'Total'], filters: ['Enviado', 'Justificante pendiente', 'Rechazado', 'Validado']}) }}

{% endblock %}
