{% extends 'firm/_review_layout.html.twig' %}

{% block title %}Bandeja de la asesoría{% endblock %}

{% block review_body %}
    <h1>Bandeja de la asesoría</h1>
    <p>Revisa los registros enviados por tus clientes.</p>
    <nav class="review-nav" aria-label="Estado de los registros">
        {% for status, label in {submitted: 'Pendientes', rejected: 'Rechazados', validated: 'Validados'} %}
            <a href="{{ path('firm_inbox', {status: status}) }}" {% if filter == status %}aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
    {% if documents is empty %}
        <p>No hay registros en esta vista.</p>
    {% else %}
        <div class="table-card" data-controller="table" data-table-filter-column-value="1"><table class="table"><caption>Registros de esta vista</caption><thead><tr><th>Cliente y documento</th><th>Estado</th><th>Total</th></tr></thead><tbody>
            {% for document in documents %}
                <tr><td>
                    <a href="{{ path('firm_document', {id: document.id}) }}">{{ document.client }} · {{ document.name }}</a>
                    </td><td><span class="status-pill">{{ document.status }}</span>
                    </td><td data-order="{{ document.total|replace({'.': '', ',': '.'}) }}" data-export="{{ document.total|replace({'.': '', ',': '.'}) }}">{{ document.total }} €
                </td></tr>
            {% endfor %}
        </tbody></table></div>
    {% endif %}
{% endblock %}
