{% macro money(cents) %}{{ (cents / 100)|number_format(2, ',', '.') }} €{% endmacro %}
{% import _self as amount %}
{% set route = quarter.access.owner ? 'client_movements' : 'firm_client_quarter' %}
{% set parameters = quarter.access.owner ? {} : {id: quarter.access.clientId} %}

<section id="quarter-summary" class="quarter-section" tabindex="-1" aria-labelledby="quarter-summary-title">
    <div class="quarter-section-heading"><h2 id="quarter-summary-title">{{ quarter.period.number }}.º trimestre de {{ quarter.period.year }}</h2><span class="quarter-state">{{ quarter.record and quarter.record.closed ? 'Trimestre cerrado' : 'Trimestre abierto' }}</span></div>
    <p>{{ quarter.record and quarter.record.closed ? 'Cerrado: cifras guardadas en el cierre.' : 'Abierto: cifras actuales.' }} {{ quarter.firmId ? 'Solo se incluyen los registros validados por la asesoría.' : 'Solo se incluyen los registros confirmados para tu control personal.' }}</p>
    <div class="client-figures">
        <section><h3>Ingresos · base</h3><p>{{ amount.money(summary.incomeCents) }}</p></section>
        <section><h3>Gastos · base</h3><p>{{ amount.money(summary.expenseCents) }}</p></section>
        <section><h3>Resultado · bases</h3><p>{{ amount.money(summary.resultCents) }}</p></section>
    </div>
    <p class="quarter-note">El resultado resta las bases de gastos a las de ingresos. Este resumen es para tu control; no es una liquidación ni una presentación de impuestos.</p>
    <details class="quarter-tax"><summary>Impuestos registrados, recargo y retención</summary>
        <ul class="plain-list">{% for tax, totals in summary.taxes %}<li><strong>{{ tax|upper }}</strong> · En ingresos: {{ amount.money(totals.output) }} · En gastos: {{ amount.money(totals.input) }} · Diferencia: {{ amount.money(totals.balance) }}</li>{% endfor %}</ul>
        <p>Recargo de equivalencia en gastos: {{ amount.money(summary.surchargeCents) }}. Retención de IRPF en ingresos: {{ amount.money(summary.withholdingCents) }}. Se muestran por separado.</p>
    </details>
</section>

<section id="quarter-pending" class="quarter-section quarter-pending" tabindex="-1" aria-labelledby="quarter-pending-title">
    <div class="quarter-section-heading"><h2 id="quarter-pending-title">Pendientes actuales · {{ quarter.calculation.pending|length }}</h2><a class="quiet-link" href="#quarter-manage" data-turbo="false">Ver estado del cierre</a></div>
    <p>Los registros pendientes del trimestre y todos los documentos sin fecha impiden cerrar. Tras un cierre, los nuevos documentos se muestran aquí sin cambiar sus cifras guardadas.</p>
    <ul class="plain-list">{% for record in quarter.calculation.pending %}<li><div><strong>{{ record.partyName ?: 'Documento pendiente de revisar' }}</strong><span class="quarter-record-meta">{{ record.date ? record.date|date('d/m/Y') : 'Sin fecha: revisar antes de cerrar' }} · {{ record.income is null ? 'Tipo pendiente' : (record.income ? 'Ingreso' : 'Gasto') }}</span></div>
    {% if quarter.access.owner %}<a href="{{ path('client_document', {id: record.id}) }}">Revisar registro</a>{% elseif quarter.firmId and record.status in ['submitted', 'rejected', 'validated'] %}<a href="{{ path('firm_document', {id: record.id}) }}">Revisar registro</a>{% else %}<span>Pendiente del cliente</span>{% endif %}</li>{% else %}<li>No hay pendientes para el cierre.</li>{% endfor %}</ul>
</section>

<section id="quarter-movements" class="quarter-section" tabindex="-1" aria-labelledby="quarter-movements-title">
    <h2 id="quarter-movements-title">Movimientos incluidos · {{ summary.movements|length }}</h2>
    <p>Busca, filtra por ingreso o gasto y exporta el listado a Excel o CSV. Los filtros del listado no cambian las cifras del resumen.</p>
    {% if summary.movements is not empty %}{{ include('finance/_movements_table.html.twig') }}{% else %}<div class="empty-state"><h3>Todavía no hay movimientos incluidos</h3><p>Los registros aparecerán al confirmarlos para el control personal o cuando los valide tu asesoría. Revisa los pendientes de este periodo.</p>{% if quarter.access.owner %}<a href="{{ path('client_document_new') }}">Añadir un documento</a>{% endif %}</div>{% endif %}
</section>

<section id="quarter-manage" class="quarter-section quarter-management" tabindex="-1" aria-labelledby="quarter-manage-title">
    <h2 id="quarter-manage-title">Estado y cierre del trimestre</h2>
    {% if canManage %}<form method="post">
        <input type="hidden" name="version" value="{{ quarter.record ? quarter.record.version : 0 }}"><input type="hidden" name="fingerprint" value="{{ quarter.calculation.fingerprint }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf) }}">
        {% if quarter.record and quarter.record.closed %}<p>La reapertura permite corregir registros y conserva la versión anterior y quién la reabrió.</p><button class="action-secondary" type="submit" name="intent" value="reopen">Reabrir trimestre</button>
        {% else %}<p>Al cerrar se guardan estas cifras y sus registros. Para cambiarlos tendrás que reabrir el trimestre.</p>{% if quarter.calculation.pending is not empty %}<p class="warning">Antes de cerrar, resuelve los registros pendientes y los documentos sin fecha. <a href="#quarter-pending" data-turbo="false">Consultar pendientes</a></p>{% endif %}<button class="action-secondary" type="submit" name="intent" value="close" {{ quarter.calculation.pending is not empty ? 'disabled' : '' }}>Cerrar trimestre</button>{% endif %}
    </form>{% else %}<p>Puedes consultar estas cifras. El cierre y la reapertura corresponden a quien gestiona este periodo.</p>{% endif %}
</section>

<section id="quarter-history" class="quarter-section" tabindex="-1" aria-labelledby="quarter-history-title">
    <h2 id="quarter-history-title">Histórico</h2>
    <details><summary>Historial de este trimestre · {{ events|length }} {{ events|length == 1 ? 'cambio' : 'cambios' }}</summary>
        <ul class="plain-list">{% for event in events %}<li><div><strong>{{ event.closed ? 'Cierre' : 'Reapertura' }}</strong> · {{ event.date }} · {{ event.author }}<p>Ingresos: {{ amount.money(event.snapshot.incomeCents) }} · Gastos: {{ amount.money(event.snapshot.expenseCents) }} · Resultado: {{ amount.money(event.snapshot.resultCents) }}</p>
        <details><summary>Ver registros de esta versión</summary><ul>{% for movement in event.snapshot.movements %}<li>{{ movement.date|date('d/m/Y') }} · {{ movement.partyName }} · {{ movement.income ? 'Ingreso' : 'Gasto' }} · Base {{ amount.money(movement.baseCents) }} · {{ movement.tax|upper }} {{ amount.money(movement.taxCents) }} · Recargo {{ amount.money(movement.surchargeCents) }} · Retención {{ amount.money(movement.withholdingCents) }} · Total {{ amount.money(movement.totalCents) }}</li>{% else %}<li>Sin movimientos.</li>{% endfor %}</ul></details></div></li>{% else %}<li>Todavía no hay cierres ni reaperturas.</li>{% endfor %}</ul>
    </details>
    <details><summary>Periodos guardados · {{ quarter.history|length }}</summary><p><a href="{{ path(route, parameters) }}">Consultar el periodo actual</a></p>
        <ul class="plain-list">{% for saved in quarter.history %}<li><a href="{{ path(route, parameters|merge({year: saved.period.year, quarter: saved.period.number, scope: saved.firmId ?? 'personal'})) }}">{{ saved.period.number }}.º trimestre de {{ saved.period.year }} · {{ saved.firmId ? 'Asesoría' : 'Control personal' }} · {{ saved.closed ? 'Cerrado' : 'Reabierto' }}</a></li>{% else %}<li>Todavía no hay periodos guardados.</li>{% endfor %}</ul>
    </details>
</section>
