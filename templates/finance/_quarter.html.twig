<div class="quarter-view" data-controller="live-quarter" data-live-quarter-auth-value="{{ path('quarter_subscription') }}" data-live-quarter-url-value="{{ app.request.requestUri }}">
    <h1>Ingresos y gastos</h1>
<p>{{ quarter.access.clientName }} · {{ quarter.firmId ? 'Validado por la asesoría' : 'Control personal' }}</p>
    <form method="get">
<label for="quarter-year">Año</label><input id="quarter-year" name="year" type="number" min="1" max="9999" value="{{ quarter.period.year }}" required>
<label for="quarter-number">Trimestre</label><select id="quarter-number" name="quarter">{% for number in 1..4 %}<option value="{{ number }}" {{ quarter.period.number == number ? 'selected' : '' }}>{{ number }}.º trimestre</option>{% endfor %}</select>
<input type="hidden" name="scope" value="{{ quarter.firmId ?? 'personal' }}"><button type="submit">Consultar</button>
</form>
    {{ include('finance/_live_status.html.twig') }}
    <div data-live-quarter-target="content">{{ include('finance/_quarter_content.html.twig') }}</div>
</div>
