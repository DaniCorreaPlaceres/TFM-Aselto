        <form method="post" novalidate data-controller="document-review" data-document-review-tax-name-value="{{ document.taxName }}" data-action="input->document-review#recalculate change->document-review#recalculate submit->document-review#submit">
            <fieldset data-field="direction" data-message="Indica si es un ingreso o un gasto.">
                <legend>Tipo</legend>
                <label class="choice">
                    <input type="radio" name="direction" value="ingreso" {% if document.direction == 'ingreso' %}checked{% endif %} {% if fieldErrors.direction is defined %}aria-invalid="true" aria-describedby="direction-error"{% endif %}>
                    Ingreso
                </label>
                <label class="choice">
                    <input type="radio" name="direction" value="gasto" {% if document.direction == 'gasto' %}checked{% endif %} {% if fieldErrors.direction is defined %}aria-invalid="true" aria-describedby="direction-error"{% endif %}>
                    Gasto
                </label>
                <p id="direction-error" class="field-error" {% if fieldErrors.direction is not defined %}hidden{% endif %}>{{ fieldErrors.direction|default('') }}</p>
            </fieldset>

            <div data-field="issuedOn" data-message="Indica la fecha.">
                <label for="issued_on">Fecha</label>
                <input id="issued_on" name="issued_on" type="date" value="{{ document.issuedOn }}" {% if fieldErrors.issuedOn is defined %}aria-invalid="true" aria-describedby="issuedOn-error"{% endif %}>
                <p id="issuedOn-error" class="field-error" {% if fieldErrors.issuedOn is not defined %}hidden{% endif %}>{{ fieldErrors.issuedOn|default('') }}</p>
            </div>

            <div data-field="partyName" data-message="Indica el tercero.">
                <label for="party_name">Tercero</label>
                <input id="party_name" name="party_name" type="text" maxlength="120" value="{{ document.partyName }}" {% if fieldErrors.partyName is defined %}aria-invalid="true" aria-describedby="partyName-error"{% endif %}>
                <p id="partyName-error" class="field-error" {% if fieldErrors.partyName is not defined %}hidden{% endif %}>{{ fieldErrors.partyName|default('') }}</p>
            </div>

            <div data-field="taxId" data-message="Indica el NIF.">
                <label for="tax_id">NIF</label>
                <input id="tax_id" name="tax_id" type="text" maxlength="20" value="{{ document.taxId }}" {% if fieldErrors.taxId is defined %}aria-invalid="true" aria-describedby="taxId-error"{% endif %}>
                <p id="taxId-error" class="field-error" {% if fieldErrors.taxId is not defined %}hidden{% endif %}>{{ fieldErrors.taxId|default('') }}</p>
            </div>

            <div data-field="base" data-message="Indica la base." data-invalid="La base no es un importe. Usa la coma para los céntimos, por ejemplo 1250,50.">
                <label for="base">Base</label>
                <input id="base" name="base" type="text" inputmode="decimal" value="{{ document.base }}" data-document-review-target="base" {% if fieldErrors.base is defined %}aria-invalid="true" aria-describedby="base-error"{% endif %}>
                <p id="base-error" class="field-error" {% if fieldErrors.base is not defined %}hidden{% endif %}>{{ fieldErrors.base|default('') }}</p>
            </div>

            <div data-field="taxRate" data-message="{{ document.rateMessage }}" data-invalid="{{ document.rateError }}">
                <label for="tax_rate">{% if document.manualTaxRate %}Porcentaje de IPSI{% else %}Tipo de {{ document.taxName }}{% endif %}</label>
                {% if document.manualTaxRate %}
                    <input id="tax_rate" name="tax_rate" type="text" inputmode="decimal" value="{{ document.taxRate|replace({'.': ','}) }}" data-document-review-target="rate" aria-describedby="tax-rate-hint{% if fieldErrors.taxRate is defined %} taxRate-error{% endif %}" {% if fieldErrors.taxRate is defined %}aria-invalid="true"{% endif %}>
                    <p id="tax-rate-hint" class="client-hint">Escribe el porcentaje que figura en el documento. Aselto no determina qué tipo corresponde.</p>
                {% else %}
                    <select id="tax_rate" name="tax_rate" data-document-review-target="rate" {% if fieldErrors.taxRate is defined %}aria-invalid="true" aria-describedby="taxRate-error"{% endif %}>
                        <option value="">Elige un tipo</option>
                        {% for rate in document.taxRates %}
                            <option value="{{ rate }}" {% if document.taxRate is same as (rate) %}selected{% endif %}>{{ rate|replace({'.': ','}) }} %</option>
                        {% endfor %}
                    </select>
                {% endif %}
                <p id="taxRate-error" class="field-error" {% if fieldErrors.taxRate is not defined %}hidden{% endif %}>{{ fieldErrors.taxRate|default('') }}</p>
            </div>

            <p id="quota" data-document-review-target="quota" aria-live="polite">Cuota de {{ document.taxName }}: {% if document.quota %}{{ document.quota }} €{% else %}se calcula con la base y {{ document.taxName }}{% endif %}</p>

            {% if document.supportsSurcharge %}
                <div data-field="surcharge" data-optional="true" data-document-review-target="surchargeGroup">
                    <label for="surcharge">Recargo de equivalencia</label>
                    <select id="surcharge" name="surcharge" data-document-review-target="surcharge" aria-describedby="surcharge-hint{% if fieldErrors.surcharge is defined %} surcharge-error{% endif %}" {% if fieldErrors.surcharge is defined %}aria-invalid="true"{% endif %}>
                        <option value="">Sin recargo</option>
                        {% for rate, vat in {'0.5': 400, '1.4': 1000, '5.2': 2100, '1.75': 2100} %}
                            <option value="{{ rate }}" data-vat-rate="{{ vat }}" {% if document.surcharge is same as (rate) %}selected{% endif %}>{{ rate|replace({'.': ','}) }} %{% if rate == '1.75' %} (tabaco){% endif %}</option>
                        {% endfor %}
                    </select>
                    <p id="surcharge-hint" class="client-hint">Solo para gastos con IVA. Elige el recargo que figura en el documento.</p>
                    <p id="surcharge-error" class="field-error" {% if fieldErrors.surcharge is not defined %}hidden{% endif %}>{{ fieldErrors.surcharge|default('') }}</p>
                    <p data-document-review-target="surchargeQuota" aria-live="polite">Cuota de recargo: {% if document.surchargeQuota %}{{ document.surchargeQuota }} €{% else %}sin recargo calculado{% endif %}</p>
                </div>
            {% endif %}

            {% if document.allowsWithholding %}
                <div data-field="withholdingRate" data-optional="true" data-invalid="Escribe un porcentaje entre 0 y 100, con hasta dos decimales, o deja el campo vacío." data-document-review-target="withholdingGroup">
                    <label for="withholding_rate">Retención de IRPF (%)</label>
                    <input id="withholding_rate" name="withholding_rate" type="text" inputmode="decimal" value="{{ document.withholdingRate|replace({'.': ','}) }}" data-document-review-target="withholding" aria-describedby="withholding-hint{% if fieldErrors.withholdingRate is defined %} withholdingRate-error{% endif %}" {% if fieldErrors.withholdingRate is defined %}aria-invalid="true"{% endif %}>
                    <p id="withholding-hint" class="client-hint">Solo para ingresos de autónomos. Deja vacío si no lleva retención; si la hay, escribe el porcentaje del documento.</p>
                    <p id="withholdingRate-error" class="field-error" {% if fieldErrors.withholdingRate is not defined %}hidden{% endif %}>{{ fieldErrors.withholdingRate|default('') }}</p>
                    <p data-document-review-target="withholdingQuota" aria-live="polite">Cuota de retención: {% if document.withholdingQuota %}{{ document.withholdingQuota }} €{% else %}sin retención calculada{% endif %}</p>
                </div>
            {% endif %}

            <label for="total">Total</label>
            <input id="total" type="text" readonly value="{{ document.total }}" data-document-review-target="total" aria-describedby="total-hint">
            <p id="total-hint" class="client-hint">Suma la base, la cuota de {{ document.taxName }} y el recargo, si lo hay.</p>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfId|default('save_document')) }}">
            <input type="hidden" name="version" value="{{ document.version }}">
            {% if reviewer|default(false) %}
                <button type="submit" name="intent" value="confirm">Validar registro</button>
            {% else %}
                <button type="submit" name="intent" value="confirm">Confirmar registro</button>
                <button type="submit" name="intent" value="draft" class="quiet">Guardar borrador</button>
            {% endif %}
        </form>
