{% extends 'base.html.twig' %}

{% block title %}He olvidado mi contraseña{% endblock %}

{% block body %}
    <main class="panel">
        <h1>He olvidado mi contraseña</h1>
        <p>Te enviaremos un enlace para crear una contraseña nueva.</p>

        {% if error %}
            <p class="error" role="alert">{{ error }}</p>
        {% endif %}

        <form method="post">
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" autocomplete="username" value="{{ email }}" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('request_password') }}">
            <button type="submit">Enviar enlace</button>
        </form>
    </main>
{% endblock %}
