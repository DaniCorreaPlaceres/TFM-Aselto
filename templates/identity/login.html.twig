{% extends 'base.html.twig' %}

{% block title %}Entra en Aselto{% endblock %}

{% block body %}
    <main class="panel">
        <h1>Entra en Aselto</h1>
        <p>Usa tu correo y tu contraseña.</p>

        {% if hasError %}
            <p class="error" role="alert">El correo o la contraseña no son correctos.</p>
        {% endif %}

        <form method="post" action="{{ path('login') }}">
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" autocomplete="username" value="{{ lastEmail }}" required>

            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Entrar</button>
        </form>
    </main>
{% endblock %}
