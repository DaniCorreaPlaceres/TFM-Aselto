{% extends 'client/_layout.html.twig' %}

{% block client_title %}Inicio{% endblock %}

{% block client_body %}
    <h1>{% if name %}Hola, {{ name }}{% else %}Hola{% endif %}</h1>
    <p>Este es el resumen de tu actividad.</p>

    <a class="action" href="{{ path('client_document_new') }}">Añadir documento</a>
    <p class="client-hint">Tus facturas y justificantes se reúnen en Documentos.</p>

    <p class="client-period">Este trimestre</p>
    <div class="client-figures">
        <section>
            <h2>Ingresos registrados</h2>
            <p aria-label="Importe pendiente de cálculo">—</p>
        </section>
        <section>
            <h2>Gastos registrados</h2>
            <p aria-label="Importe pendiente de cálculo">—</p>
        </section>
    </div>
    <p class="client-hint">El resumen del trimestre todavía no está disponible. Consulta el estado de tus registros en Documentos.</p>

    <section class="client-pending">
        <h2>Pendiente de revisión</h2>
        {% if pending is empty %}
            <p>No hay nada pendiente de revisión.</p>
        {% else %}
            <ul class="plain-list">
                {% for item in pending %}
                    <li><a href="{{ item.href }}">{{ item.name }}</a> <span>{{ item.status }}</span></li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}
