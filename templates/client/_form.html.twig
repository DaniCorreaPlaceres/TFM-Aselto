<form method="post">
    <fieldset>
        <legend>Tipo</legend>
        <label class="choice">
            <input type="radio" name="kind" value="autonomo" {% if kind == 'autonomo' %}checked{% endif %} required>
            Autónomo
        </label>
        <label class="choice">
            <input type="radio" name="kind" value="sociedad" {% if kind == 'sociedad' %}checked{% endif %}>
            Sociedad
        </label>
    </fieldset>

    <label for="name">Nombre</label>
    <input id="name" name="name" type="text" value="{{ name }}" required maxlength="120">

    <label for="email">Correo</label>
    <input id="email" name="email" type="email" autocomplete="off" value="{{ email }}" required>

    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" autocomplete="new-password" required>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf) }}">
    <button type="submit">{{ submit }}</button>
</form>
