{% extends 'base.html.twig' %}

{% block title %}Clientes{% endblock %}

{% block body %}
    <main class="panel wide">
        <h1>Clientes</h1>
        {% if unlinked %}
            <p>Sin asesoría.</p>
        {% endif %}

        {% for message in app.flashes('success') %}
            <p class="success">{{ message }}</p>
        {% endfor %}

        {% if clients is empty %}
            <p>Todavía no hay clientes.</p>
        {% else %}
            <div class="table-card" data-controller="table" data-table-filter-column-value="1"><table class="table"><caption>Clientes de tu ámbito</caption><thead><tr><th>Nombre</th><th>Tipo</th><th>Correo</th>{% if not unlinked %}<th class="no-export">Acciones</th>{% endif %}</tr></thead><tbody>
                {% for client in clients %}
                    <tr><td>
                        <strong><a href="{{ path('client_fiscal', {id: client.id}) }}">{{ client.name }}</a></strong>
                        </td><td>{{ client.kind }}
                        </td><td>{{ client.email }}
                        {% if not unlinked %}</td><td><a href="{{ path('firm_client_quarter', {id: client.id}) }}">Ver trimestre</a>{% endif %}
                    </td></tr>
                {% endfor %}
            </tbody></table></div>
        {% endif %}

        {% if canCreate %}
            <h2>Dar de alta un cliente</h2>
            <p>Le enviaremos un correo para confirmar su dirección y crear su contraseña.</p>

            {% if error %}
                <p class="error" role="alert">{{ error }}</p>
            {% endif %}

            {{ include('client/_form.html.twig', {csrf: 'create_client', submit: 'Guardar'}) }}
        {% endif %}
    </main>
{% endblock %}
