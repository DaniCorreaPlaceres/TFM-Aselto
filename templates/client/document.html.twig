{% extends 'client/_layout.html.twig' %}

{% block client_title %}Revisar documento{% endblock %}

{% block client_body %}
    <h1>Revisar documento</h1>
    <p>{{ document.originalName }} · {{ document.status }}</p>

    {% if document.image %}
        <img class="document-preview" src="{{ path('client_document_file', {id: document.id}) }}" alt="Vista del documento">
    {% else %}
        <p><a href="{{ path('client_document_file', {id: document.id}) }}">Ver archivo</a></p>
    {% endif %}

    {% if document.editable %}
        <p>Escribe los datos y revísalos antes de confirmar. El total se calcula con la base y el IVA.</p>
        <form method="post" novalidate data-controller="document-review" data-action="input->document-review#recalculate change->document-review#recalculate submit->document-review#submit">
            <fieldset data-field="direction" data-message="Indica si es un ingreso o un gasto.">
                <legend>Tipo</legend>
                <label class="choice">
                    <input type="radio" name="direction" value="ingreso" {% if document.direction == 'ingreso' %}checked{% endif %} {% if fieldErrors.direction is defined %}aria-invalid="true" aria-describedby="direction-error"{% endif %}>
                    Ingreso
                </label>
                <label class="choice">
                    <input type="radio" name="direction" value="gasto" {% if document.direction == 'gasto' %}checked{% endif %} {% if fieldErrors.direction is defined %}aria-invalid="true" aria-describedby="direction-error"{% endif %}>
                    Gasto
                </label>
                <p id="direction-error" class="field-error" {% if fieldErrors.direction is not defined %}hidden{% endif %}>{{ fieldErrors.direction|default('') }}</p>
            </fieldset>

            <div data-field="issuedOn" data-message="Indica la fecha.">
                <label for="issued_on">Fecha</label>
                <input id="issued_on" name="issued_on" type="date" value="{{ document.issuedOn }}" {% if fieldErrors.issuedOn is defined %}aria-invalid="true" aria-describedby="issuedOn-error"{% endif %}>
                <p id="issuedOn-error" class="field-error" {% if fieldErrors.issuedOn is not defined %}hidden{% endif %}>{{ fieldErrors.issuedOn|default('') }}</p>
            </div>

            <div data-field="partyName" data-message="Indica el tercero.">
                <label for="party_name">Tercero</label>
                <input id="party_name" name="party_name" type="text" maxlength="120" value="{{ document.partyName }}" {% if fieldErrors.partyName is defined %}aria-invalid="true" aria-describedby="partyName-error"{% endif %}>
                <p id="partyName-error" class="field-error" {% if fieldErrors.partyName is not defined %}hidden{% endif %}>{{ fieldErrors.partyName|default('') }}</p>
            </div>

            <div data-field="taxId" data-message="Indica el NIF.">
                <label for="tax_id">NIF</label>
                <input id="tax_id" name="tax_id" type="text" maxlength="20" value="{{ document.taxId }}" {% if fieldErrors.taxId is defined %}aria-invalid="true" aria-describedby="taxId-error"{% endif %}>
                <p id="taxId-error" class="field-error" {% if fieldErrors.taxId is not defined %}hidden{% endif %}>{{ fieldErrors.taxId|default('') }}</p>
            </div>

            <div data-field="base" data-message="Indica la base." data-invalid="La base no es un importe. Usa la coma para los céntimos, por ejemplo 1250,50.">
                <label for="base">Base</label>
                <input id="base" name="base" type="text" inputmode="decimal" value="{{ document.base }}" data-document-review-target="base" {% if fieldErrors.base is defined %}aria-invalid="true" aria-describedby="base-error"{% endif %}>
                <p id="base-error" class="field-error" {% if fieldErrors.base is not defined %}hidden{% endif %}>{{ fieldErrors.base|default('') }}</p>
            </div>

            <div data-field="vatRate" data-message="Elige el tipo de IVA.">
                <label for="vat_rate">Tipo de IVA</label>
                <select id="vat_rate" name="vat_rate" data-document-review-target="vat" {% if fieldErrors.vatRate is defined %}aria-invalid="true" aria-describedby="vatRate-error"{% endif %}>
                    <option value="">Elige un tipo</option>
                    {% for rate in [0, 4, 10, 21] %}
                        <option value="{{ rate }}" {% if document.vatRate is same as (rate ~ '') %}selected{% endif %}>{{ rate }} %</option>
                    {% endfor %}
                </select>
                <p id="vatRate-error" class="field-error" {% if fieldErrors.vatRate is not defined %}hidden{% endif %}>{{ fieldErrors.vatRate|default('') }}</p>
            </div>

            <p id="quota" data-document-review-target="quota">Cuota de IVA: {% if document.quota %}{{ document.quota }} €{% else %}se calcula con la base y el IVA{% endif %}</p>

            <label for="total">Total</label>
            <input id="total" type="text" readonly value="{{ document.total }}" data-document-review-target="total" aria-describedby="total-hint">
            <p id="total-hint" class="client-hint">Se calcula con la base y el IVA.</p>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('save_document') }}">
            <button type="submit" name="intent" value="confirm">Confirmar registro</button>
            <button type="submit" name="intent" value="draft" class="quiet">Guardar borrador</button>
        </form>
    {% else %}
        <p>{% if hasFirm %}Has confirmado el registro. Tu asesoría todavía no lo ha validado.{% else %}Has confirmado el registro.{% endif %}</p>
        <ul class="plain-list">
            <li><span>Tipo</span>{{ document.directionLabel }}</li>
            <li><span>Fecha</span>{{ document.issuedOnLabel }}</li>
            <li><span>Tercero</span>{{ document.partyName }}</li>
            <li><span>NIF</span>{{ document.taxId }}</li>
            <li><span>Base</span>{{ document.baseLabel }} €</li>
            <li><span>IVA</span>{{ document.vatRate }} %</li>
            <li><span>Cuota</span>{{ document.quota }} €</li>
            <li><span>Total</span>{{ document.totalLabel }} €</li>
        </ul>
    {% endif %}
{% endblock %}
