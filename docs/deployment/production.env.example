# Documentation example only. Keep the real .env.local outside public_html, mode 0600.
# Replace every REPLACE_* value privately before use; never commit the real file.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_PRIVATE_RANDOM_SECRET
DEFAULT_URI=https://aselto.com
TRUSTED_HOSTS='^aselto\.com$'
DATABASE_URL='mysql://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_DB_HOST:3306/REPLACE_DB_NAME?serverVersion=11.8.9-MariaDB&charset=utf8mb4'
JWT_PASSPHRASE=REPLACE_WITH_PRIVATE_JWT_PASSPHRASE
MAILER_DSN=REPLACE_WITH_PRIVATE_SMTP_DSN
MAILER_FROM='Aselto <no-responder@aselto.com>'
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Manual production mode does not contact a hub; these URLs are not services to install.
MERCURE_URL=http://127.0.0.1:1/.well-known/mercure
MERCURE_PUBLIC_URL=http://127.0.0.1:1/.well-known/mercure
MERCURE_JWT_SECRET=REPLACE_WITH_PRIVATE_UNUSED_HUB_SECRET
SECURITY_ALERT_EMAIL_ENABLED=0
SECURITY_ALERT_RECIPIENT=webmaster@aselto.com
SECURITY_ALERT_FROM=REPLACE_WITH_VERIFIED_SENDER
